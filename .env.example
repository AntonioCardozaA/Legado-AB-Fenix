ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ULTRAMSG_DEFAULT_RECIPIENT=
ULTRAMSG_QUEUE=default

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

ELONGACION_ALERT_ENABLED=true
ELONGACION_ALERT_TIMEZONE=America/Mexico_City
ELONGACION_ALERT_SCHEDULE_TIME=09:00
ELONGACION_ALERT_WHATSAPP_RECIPIENTS=

AI_ENABLED=false
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=
AI_FALLBACK_TRANSIENT_STATUSES=408,429,500,502,503,504
AI_TIMEOUT=30
AI_JOB_TIMEOUT=
AI_MAX_RETRIES=2
AI_QUEUE=maintenance-ai
AI_DISPATCH_MODE=queue
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_PROMPT_VERSION=washer-action-plan-v1
AI_MAX_PLANS_PER_EVENT=1
AI_MAX_CONTEXT_CHARS=18000
AI_MAX_KNOWLEDGE_CHUNKS=6

AI_CHAT_MODEL=
AI_CHAT_HISTORY_WINDOW=8
AI_CHAT_MAX_STORED_MESSAGES=30
AI_CHAT_MAX_CONTEXT_ITEMS=5
AI_CHAT_RATE_LIMIT_PER_MINUTE=12

AI_PLATFORM_SCHEMA_TABLE_LIMIT=8
AI_PLATFORM_SCHEMA_COLUMN_LIMIT=14
AI_PLATFORM_RECENT_ACTIVITY_LIMIT=4
AI_PLATFORM_RECENT_EVIDENCE_LIMIT=4
AI_PLATFORM_QUERY_MATCH_LIMIT=8

AI_KNOWLEDGE_CHUNK_SIZE=1200
AI_KNOWLEDGE_CHUNK_OVERLAP=200
AI_KNOWLEDGE_SEMANTIC_QUERY_ENABLED=true
AI_KNOWLEDGE_CANDIDATE_LIMIT=120
AI_KNOWLEDGE_MIN_SCORE=1
AI_KNOWLEDGE_LEXICAL_WEIGHT=2
AI_KNOWLEDGE_METADATA_WEIGHT=1
