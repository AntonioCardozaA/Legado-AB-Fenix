DirectoryIndex index.php

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=LEGADO_IMMUTABLE
    Header merge Vary Accept-Encoding env=LEGADO_IMMUTABLE
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Only existing public assets with generated content hashes are immutable.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(?:build/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(?:css|js)(?:\.gz)?|images/optimized/[^/]+-[a-f0-9]{12}\.webp)$ - [E=LEGADO_IMMUTABLE:1]

    # Precompressed builds also work when mod_deflate is unavailable.
    <IfModule mod_headers.c>
    RewriteCond %{HTTP:Accept-Encoding} "(^|,)\s*gzip(?:\s*;[^,]*)?(?:,|$)" [NC]
    RewriteCond %{HTTP:Accept-Encoding} "!(^|,)\s*gzip\s*;\s*q=0(?:\.0*)?\s*(?:,|$)" [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^build/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(?:css|js)$ %{REQUEST_URI}.gz [L]
    </IfModule>

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>


<FilesMatch "-[A-Za-z0-9_-]{8,}\.css\.gz$">
    ForceType text/css
    <IfModule mod_env.c>
        SetEnv no-gzip 1
    </IfModule>
    <IfModule mod_headers.c>
        Header set Content-Encoding gzip
    </IfModule>
</FilesMatch>
<FilesMatch "-[A-Za-z0-9_-]{8,}\.js\.gz$">
    ForceType application/javascript
    <IfModule mod_env.c>
        SetEnv no-gzip 1
    </IfModule>
    <IfModule mod_headers.c>
        Header set Content-Encoding gzip
    </IfModule>
</FilesMatch>